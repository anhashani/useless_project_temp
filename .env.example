# OpenAI API Key (Required for live generation)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default model (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Django Secret Key (Optional in dev, defaults to a development secret key)
DJANGO_SECRET_KEY=django-insecure-excusegen-dev-key-change-in-production

# Django Debug mode (True/False)
DJANGO_DEBUG=True
